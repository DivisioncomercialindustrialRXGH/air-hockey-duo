{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "air-hockey-duo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HOCKEY_HUB", "class_name": "HockeyHub" }
    ]
  },
  // RC2: validated historical impulse, zero positional rewind. Changes
  // take effect in a new deployment/instance; disabling does not undo other fixes.
  "vars": {
    "LAG_COMP_MAX_MS": "360",
    "LAG_COMP_MAX_JUMP_PX": "14"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HockeyHub"] }
  ]
}
